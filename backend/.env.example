# Copy this file to .env and fill the values for local development
# Do NOT commit your .env to version control (use .env.example only)

# Devise JWT secret (generate with `rails secret`)
DEVISE_JWT_SECRET_KEY=your-devise-jwt-secret

# Database URL (optional override)
# DATABASE_URL=postgres://user:password@localhost:5432/mksurvey_development

# Any other env vars go here
